{
  "name": "perplexity-cli",
  "version": "1.0.0",
  "description": "A CLI tool that searches the web and generates AI-powered answers with sources",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "perplexity-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "genkit start -- tsx index.ts",
    "watch": "genkit start -- tsc --watch"
  },
  "keywords": [
    "cli",
    "ai",
    "search",
    "perplexity",
    "genkit",
    "tavily"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@genkit-ai/googleai": "^1.24.0",
    "@tavily/core": "^0.5.12",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "genkit": "^1.24.0",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

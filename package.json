{
  "name": "perplexity-cli",
  "version": "1.0.0",
  "description": "A CLI tool that searches the web and generates AI-powered answers with sources",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "perplexity-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "genkit start -- tsx index.ts",
    "watch": "genkit start -- tsc --watch",
    "lint": "eslint \"src/**/*.ts\" \"*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\""
  },
  "keywords": [
    "cli",
    "ai",
    "search",
    "perplexity",
    "genkit",
    "tavily"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@genkit-ai/googleai": "^1.24.0",
    "@tavily/core": "^0.6.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "genkit": "^1.24.0",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
